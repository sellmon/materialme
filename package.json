{
  "name": "materialme",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "sync:components": "node scripts/sync-components.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:cli": "pnpm --filter materialme-cli build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter preview dev",
    "ci": "pnpm typecheck && pnpm build:cli && pnpm build:registry && pnpm --filter preview build"
  }
}
